  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CodeSystem ehds-data-category-cs</b></p><a name=\"ehds-data-category-cs\"> </a><a name=\"hcehds-data-category-cs\"> </a><p>This case-sensitive code system <code>http://example.org/fhir/eu-ai-transparency/CodeSystem/ehds-data-category-cs</code> defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">ehr<a name=\"ehds-data-category-cs-ehr\"> </a></td><td>Electronic Health Records</td><td>Electronic health data originating from electronic health records.</td></tr><tr><td style=\"white-space:nowrap\">health-factors<a name=\"ehds-data-category-cs-health-factors\"> </a></td><td>Health Determinant Data</td><td>Data concerning factors that influence health, including socioeconomic, environmental, and behavioural determinants.</td></tr><tr><td style=\"white-space:nowrap\">healthcare-resources<a name=\"ehds-data-category-cs-healthcare-resources\"> </a></td><td>Healthcare Needs, Resources and Financing Data</td><td>Aggregated data concerning healthcare needs, allocated resources, access to healthcare, healthcare expenditure, and financing.</td></tr><tr><td style=\"white-space:nowrap\">pathogen-data<a name=\"ehds-data-category-cs-pathogen-data\"> </a></td><td>Pathogen Data</td><td>Data concerning pathogens that affect human health.</td></tr><tr><td style=\"white-space:nowrap\">admin-claims<a name=\"ehds-data-category-cs-admin-claims\"> </a></td><td>Administrative and Claims Data</td><td>Health-related administrative data, including claims and reimbursement information.</td></tr><tr><td style=\"white-space:nowrap\">human-genomic<a name=\"ehds-data-category-cs-human-genomic\"> </a></td><td>Human Genetic, Epigenomic and Genomic Data</td><td>Human genetic, epigenomic, and genomic data.</td></tr><tr><td style=\"white-space:nowrap\">molecular-omics<a name=\"ehds-data-category-cs-molecular-omics\"> </a></td><td>Human Molecular Data</td><td>Human molecular data, including proteomic, transcriptomic, metabolomic, lipidomic, and comparable omics data.</td></tr><tr><td style=\"white-space:nowrap\">device-generated-personal<a name=\"ehds-data-category-cs-device-generated-personal\"> </a></td><td>Person-Generated Device Data</td><td>Personal electronic health data generated automatically through medical devices.</td></tr><tr><td style=\"white-space:nowrap\">wellness-apps<a name=\"ehds-data-category-cs-wellness-apps\"> </a></td><td>Wellness Application Data</td><td>Electronic health-related data generated through wellness applications.</td></tr><tr><td style=\"white-space:nowrap\">professional-status<a name=\"ehds-data-category-cs-professional-status\"> </a></td><td>Healthcare Professional Data</td><td>Data concerning the professional status, specialization, and institution of healthcare professionals involved in treatment.</td></tr><tr><td style=\"white-space:nowrap\">public-health-registry<a name=\"ehds-data-category-cs-public-health-registry\"> </a></td><td>Population-Based Health Registry Data</td><td>Data from population-based health registries.</td></tr><tr><td style=\"white-space:nowrap\">medical-mortality-registry<a name=\"ehds-data-category-cs-medical-mortality-registry\"> </a></td><td>Medical and Mortality Registry Data</td><td>Data from medical registries and mortality registries.</td></tr><tr><td style=\"white-space:nowrap\">clinical-trial<a name=\"ehds-data-category-cs-clinical-trial\"> </a></td><td>Clinical Study and Investigation Data</td><td>Data from clinical trials, clinical studies, clinical investigations, and performance studies.</td></tr><tr><td style=\"white-space:nowrap\">medical-device-other<a name=\"ehds-data-category-cs-medical-device-other\"> </a></td><td>Other Medical Device Data</td><td>Other electronic health data generated through medical devices that are not represented by a more specific category.</td></tr><tr><td style=\"white-space:nowrap\">medicinal-device-registry<a name=\"ehds-data-category-cs-medicinal-device-registry\"> </a></td><td>Medicinal Product and Medical Device Registry Data</td><td>Data from registries for medicinal products and medical devices.</td></tr><tr><td style=\"white-space:nowrap\">research-cohort-survey<a name=\"ehds-data-category-cs-research-cohort-survey\"> </a></td><td>Research Cohort, Questionnaire and Survey Data</td><td>Data from research cohorts, questionnaires, and health-related surveys.</td></tr><tr><td style=\"white-space:nowrap\">biobank<a name=\"ehds-data-category-cs-biobank\"> </a></td><td>Biobank Data</td><td>Electronic health data from biobanks and associated databases.</td></tr></table></div>"^^rdf:XMLLiteral ]
