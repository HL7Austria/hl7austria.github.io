  fhir:snapshot [
     fhir:element ( [
       fhir:id [ fhir:v "Person" ] ;
       fhir:path [ fhir:v "Person" ] ;
       fhir:short [ fhir:v "A generic person record" ] ;
       fhir:definition [ fhir:v "Demographics and administrative information about a person independent of a specific health-related context." ] ;
       fhir:comment [ fhir:v "The Person resource does justice to person registries that keep track of persons regardless of their role. The Person resource is also a primary resource to point to for people acting in a particular role such as SubjectofCare, Practitioner, and Agent. Very few attributes are specific to any role and so Person is kept lean. Most attributes are expected to be tied to the role the Person plays rather than the Person himself. Examples of that are Guardian (SubjectofCare), ContactParty (SubjectOfCare, Practitioner), and multipleBirthInd (SubjectofCare)." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:base [
         fhir:path [ fhir:v "Person" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "*" ]
       ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "dom-2" ] ;
         fhir:severity [ fhir:v "error" ] ;
