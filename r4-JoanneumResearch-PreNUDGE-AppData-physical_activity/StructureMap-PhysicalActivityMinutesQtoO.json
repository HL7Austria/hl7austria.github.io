      },
      {
        "name" : "SetAggregateQuantity",
        "source" : [{
          "context" : "src"
        }],
        "target" : [{
          "context" : "aggComp",
          "contextType" : "variable",
          "element" : "value",
          "variable" : "qty",
          "transform" : "create",
          "parameter" : [{
            "valueString" : "Quantity"
          }]
        }],
        "rule" : [{
          "name" : "ComputeAggregateMinutes",
          "source" : [{
