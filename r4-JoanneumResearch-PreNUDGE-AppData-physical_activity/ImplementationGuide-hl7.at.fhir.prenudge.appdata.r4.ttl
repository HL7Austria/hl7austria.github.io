       ] ;
       fhir:name [ fhir:v "Physical Activity Minutes O - (a) Aggregate Only (Manual)" ] ;
       fhir:description [ fhir:v "Scenario (a): only component[aggregateActivity] is present.\nTypical for a questionnaire-derived observation that asks only for total activity\ntime without splitting moderate and vigorous.  pa-agg-01 passes silently because\nneither moderate nor vigorous is present." ] ;
       fhir:example [
         a fhir:Canonical ;
         fhir:v "https://fhir.hl7.at/prenudge/appdata/r4/StructureDefinition/at-prenudge-physical-activity-minutes-observation"^^xsd:anyURI ;
