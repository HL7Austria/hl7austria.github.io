         fhir:reference [ fhir:v "Observation/physical-activity-minutes-moderate-aggregate-example" ]
       ] ;
       fhir:name [ fhir:v "Physical Activity Minutes O - (c) Moderate + Aggregate (Manual)" ] ;
       fhir:description [ fhir:v "Scenario (c): component[moderateActivity] and component[aggregateActivity] present;\nvigorousActivity absent (implicitly 0).  aggregateActivity = moderateActivity + (0 × 2) = 90 min/wk.\npa-agg-01 is satisfied.  Typical for a structured questionnaire that reports\nmoderate-intensity activity separately and includes the computed aggregate." ] ;
       fhir:example [
         a fhir:Canonical ;
