           fhir:v "http://hl7.org/fhir/StructureDefinition/minValue"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/minValue>
         ] ;
         fhir:value [
           a fhir:Integer ;
           fhir:v 0
         ]
       ] [
         fhir:url [
           fhir:v "http://hl7.org/fhir/StructureDefinition/maxValue"^^xsd:anyURI ;
