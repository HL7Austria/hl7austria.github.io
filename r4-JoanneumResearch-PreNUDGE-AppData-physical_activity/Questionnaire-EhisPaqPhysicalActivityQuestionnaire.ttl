         ] ;
         fhir:value [
           a fhir:Integer ;
           fhir:v 59
         ]
       ] ) ;
       fhir:linkId [ fhir:v "Q7-minutes" ] ;
       fhir:text [ fhir:v "Minuten pro Woche (zusätzlich zu den Stunden)" ] ;
