            <parameter>
              <valueString value="http://unitsofmeasure.org"/>
            </parameter>
          </target>
        </rule>
        <rule>
          <name value="SetUCUM"/>
          <source>
            <context value="src"/>
          </source>
          <target>
            <context value="qty"/>
            <contextType value="variable"/>
            <element value="code"/>
            <transform value="copy"/>
            <parameter>
              <valueString value="min/wk"/>
            </parameter>
          </target>
        </rule>
      </rule>
    </rule>
  </group>
