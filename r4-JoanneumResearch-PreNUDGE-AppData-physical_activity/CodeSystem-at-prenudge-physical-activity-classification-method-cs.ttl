  fhir:description [ fhir:v "Codes for the algorithm or technique used to classify the intensity of a physical activity measurement into moderate / vigorous categories."] ; # 
  fhir:caseSensitive [ fhir:v true] ; # 
  fhir:content [ fhir:v "complete"] ; # 
