  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "dr-practitioner"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Practitioner dr-practitioner</b></p><a name=\"dr-practitioner\"> </a><a name=\"hcdr-practitioner\"> </a><p><b>name</b>: Dana Reviewer </p></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:name ( [
     fhir:family [ fhir:v "Reviewer" ] ;
