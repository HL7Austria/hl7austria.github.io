# - resource -------------------------------------------------------------------

<http://example.org/fhir/eu-ai-transparency/Patient/dr-patient> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "dr-patient"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient dr-patient</b></p><a name=\"dr-patient\"> </a><a name=\"hcdr-patient\"> </a><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Anonymous Patient Female, DoB: 1965-06-15</p><hr/></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:gender [ fhir:v "female"] ; # 
  fhir:birthDate [ fhir:v "1965-06-15"^^xsd:date] . # 

