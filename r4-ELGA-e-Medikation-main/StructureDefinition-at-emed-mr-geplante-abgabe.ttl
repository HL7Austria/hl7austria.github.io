       fhir:short [ fhir:v "Gibt an, ob das Arzneimittel substituiert werden darf oder nicht.\nErläutert die Absicht des verschreibenden Arztes. Keine Verwendung in der geplanten Abgabe." ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.priorPrescription" ] ;
       fhir:path [ fhir:v "MedicationRequest.priorPrescription" ] ;
       fhir:short [ fhir:v "Im Falle einer Änderung wird auf die ersetzte geplante Abgabe verwiesen. Keine Verwendung in der geplanten Abgabe." ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.detectedIssue" ] ;
       fhir:path [ fhir:v "MedicationRequest.detectedIssue" ] ;
       fhir:short [ fhir:v "Klinisches Problem mit Maßnahme, mittels Referenz auf Ressouce DetectedIssue. Keine Verwendung in der geplanten \nAbgabe." ] ;
       fhir:max [ fhir:v "0" ]
     ] [
