       fhir:short [ fhir:v "Vollständige Darstellung der Dosierungsanweisungen" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
