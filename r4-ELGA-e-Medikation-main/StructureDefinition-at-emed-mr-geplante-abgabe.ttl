       fhir:id [ fhir:v "MedicationRequest.identifier" ] ;
       fhir:path [ fhir:v "MedicationRequest.identifier" ] ;
       fhir:short [ fhir:v "Gepante-Abgabe-ID. TODO: Verwendung noch zu prüfen, evtl. basedon mit logischem Identifier ausreichend." ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.status" ] ;
       fhir:path [ fhir:v "MedicationRequest.status" ] ;
       fhir:short [ fhir:v "Status der geplanten Abgabe: active | completed | entered-in-error | stopped. Details siehe Definition." ] ;
       fhir:definition [ fhir:v "Status der geplanten Abgabe:\n* \\\"active\\\": offene, geplante Abgabe \n* \\\"completed\\\": implizit mittels Custom Operation gesetzt, nachdem alle Abgaben durchgeführt wurden (Rezept komplett eingelöst) (TODO: techn. prüfen) \n* \\\"entered-in-error\\\": nach fehlerhafter Eingabe; Storno nur möglich, wenn noch keine zugehörige Abgabe durchgeführt wurde (TODO: techn. prüfen?) \n* \\\"stopped\\\": TODO: Verwendung zu prüfen (Status soll analog zu e-Rezept abgebildet werden)\n(nicht verwendet: on-hold, stopped, cancelled, draft, unknown)" ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "https://fhir.hl7.at/elga/emed/r4/ValueSet/GeplanteAbgabeStatusVS"^^xsd:anyURI ;
