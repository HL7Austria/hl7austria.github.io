  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "MedicationRequest" ] ;
       fhir:path [ fhir:v "MedicationRequest" ] ;
       fhir:short [ fhir:v "Geplante Abgabe eines Arzneimittels aus dem Medikationsplan. Verwendet R5 Backport Extensions." ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.extension" ] ;
       fhir:path [ fhir:v "MedicationRequest.extension" ] ;
