         ] ) ;
         fhir:ordered [ fhir:v false ] ;
         fhir:rules [ fhir:v "open" ]
       ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.extension:effectiveDosePeriod" ] ;
       fhir:path [ fhir:v "MedicationRequest.extension" ] ;
       fhir:sliceName [ fhir:v "effectiveDosePeriod" ] ;
       fhir:short [ fhir:v "Zeitraum, in dem die Medikation eingenommen werden soll." ] ;
       fhir:definition [ fhir:v "Zeitraum, über den die Medikation eingenommen werden soll. Wenn mehrere dosageInstruction-Zeilen vorhanden sind (z. B. bei einer ausschleichenden Dosierung), entspricht dieser Zeitraum dem frühesten Startdatum und dem spätesten Enddatum der dosageInstructions." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Extension"^^xsd:anyURI ;
           fhir:l fhir:Extension
         ] ;
