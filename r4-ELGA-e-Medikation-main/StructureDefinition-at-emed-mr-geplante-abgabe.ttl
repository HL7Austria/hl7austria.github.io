     ] [
       fhir:id [ fhir:v "MedicationRequest.instantiatesUri" ] ;
       fhir:path [ fhir:v "MedicationRequest.instantiatesUri" ] ;
       fhir:short [ fhir:v "URL, die auf ein extern gepflegtes Protokoll (Richtlinie, Guideline) verweist, das von dieser \ngeplanten Abgabe ganz oder teilweise eingehalten wird. Keine Verwendung in der geplanten Abgabe." ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.basedOn" ] ;
       fhir:path [ fhir:v "MedicationRequest.basedOn" ] ;
       fhir:short [ fhir:v "Referenz auf die (aktuelle) Version des zugrundeliegenden Medikationsplaneintrags, auf dem diese geplante Abgabe basiert.\nTODO: zu prüfen: zusätzliche logische Referenz: reference.identifier \n{Medikationsplaneintrag-ID}_{Medikationsplaneintrag-ID_Version}." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Reference"^^xsd:anyURI ;
           fhir:l fhir:Reference
         ] ;
         fhir:targetProfile ( [
           fhir:v "https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-emed-mr-planeintrag"^^xsd:anyURI ;
           fhir:l <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-emed-mr-planeintrag>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.groupIdentifier" ] ;
       fhir:path [ fhir:v "MedicationRequest.groupIdentifier" ] ;
       fhir:short [ fhir:v "Als groupIdentifier dient die eMED-ID, die auch im e-Rezept mitgeführt wird. \nWerden von einem:r Arzt:Ärtztin mehrere Arzneimittel gleichzeitig verordnet, \nwird für jedes Arzneimittel eine geplante Abgabe mit demselben groupIdentifier erstellt (bildet 'Rezept-Klammer').\nTODO: eMED-ID Wording ist evtl. aufgrund des Parallelbetriebs noch anzupassen" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.courseOfTherapyType" ] ;
       fhir:path [ fhir:v "MedicationRequest.courseOfTherapyType" ] ;
       fhir:short [ fhir:v "Gesamtmuster der Medikamentengabe (z.B. saisonal). Keine Verwendung in der geplanten Abgabe." ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.insurance" ] ;
       fhir:path [ fhir:v "MedicationRequest.insurance" ] ;
       fhir:short [ fhir:v "Versicherungsinformatinen als Coverage oder ClaimResponse Resource. Keine Verwendung in der geplanten Abgabe." ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.note" ] ;
       fhir:path [ fhir:v "MedicationRequest.note" ] ;
       fhir:short [ fhir:v "Zusätzliche Informationen zur geplanten Abgabe (Kommunikations zw. Arzt und Apotheke); die nicht die Dosierung betreffen. \nTODO: prüfen was CDA derzeit zulässt; HL7 Consultation, ob Feld benötigt" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.dosageInstruction" ] ;
       fhir:path [ fhir:v "MedicationRequest.dosageInstruction" ] ;
       fhir:short [ fhir:v "Angabe der Dosierinformationen. TODO: Dosiervarianten." ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Dosage"^^xsd:anyURI ;
           fhir:l fhir:Dosage
         ] ;
         fhir:profile ( [
           fhir:v "https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-emed-dosage"^^xsd:anyURI ;
           fhir:l <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-emed-dosage>
         ] )
       ] )
     ] [
       fhir:id [ fhir:v "MedicationRequest.dispenseRequest" ] ;
       fhir:path [ fhir:v "MedicationRequest.dispenseRequest" ] ;
       fhir:short [ fhir:v "Details zur geplanten Abgabe des Arzneimittels." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.dispenseRequest.initialFill" ] ;
       fhir:path [ fhir:v "MedicationRequest.dispenseRequest.initialFill" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.dispenseRequest.initialFill.quantity" ] ;
       fhir:path [ fhir:v "MedicationRequest.dispenseRequest.initialFill.quantity" ] ;
       fhir:short [ fhir:v "Anzahl der Einheiten für die erste Abgabe, z.B. 30 Kapseln oder 100 mg. Keine Verwendung in der geplanten Abgabe." ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.dispenseRequest.dispenseInterval" ] ;
       fhir:path [ fhir:v "MedicationRequest.dispenseRequest.dispenseInterval" ] ;
       fhir:short [ fhir:v "Mindestzeitraum zwischen den Abgaben. Keine Verwendung in der geplanten Abgabe." ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.dispenseRequest.validityPeriod" ] ;
       fhir:path [ fhir:v "MedicationRequest.dispenseRequest.validityPeriod" ] ;
       fhir:short [ fhir:v "Die Anzahl der weiteren möglichen Einlösungen ist abhängig von der Rezeptart (siehe Definition)." ] ;
       fhir:definition [ fhir:v "Anzahl der weiteren möglichen Einlösungen:\n* **Kassenrezept**: keine weitere Einlösung möglich (fixer Wert 0)\n* **Privatrezept**: bis zu 6 Einlösungen, Anzahl der möglichen Einlösungen kann vom Arzt definiert werden\n* **Sustitutionsrzepet**: keine weitere Einlösung möglich (fixer Wert 0) \n\nTODO: Techn. Prüfung: Wenn Kassenrezept oder Substitutionsrezept, dann 0. Verpflichtende Eingabe, wenn Privatrezept, max 6." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.dispenseRequest.numberOfRepeatsAllowed" ] ;
       fhir:path [ fhir:v "MedicationRequest.dispenseRequest.numberOfRepeatsAllowed" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.dispenseRequest.quantity" ] ;
       fhir:path [ fhir:v "MedicationRequest.dispenseRequest.quantity" ] ;
       fhir:short [ fhir:v "Menge des Medikaments, die bei jeder Abgabe bereitgestellt werden soll. \nDa sich die Angaben zum Arzneimittel jeweils auf eine Packung der Arznei beziehen, MUSS die Anzahl der auszugebenden Packungen angegeben werden (mindestens 1). \nDies gilt für Arzneimittel mit PZN und magistralen Zubereitungen." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "MedicationRequest.dispenseRequest.expectedSupplyDuration" ] ;
