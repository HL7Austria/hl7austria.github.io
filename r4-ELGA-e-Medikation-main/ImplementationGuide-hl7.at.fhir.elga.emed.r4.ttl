         fhir:Reference.reference [ fhir:value "StructureDefinition/at-elga-emed-dosage-dosierung" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "AT ELGA e-Medikation Dosage Dosierung" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "AT ELGA e-Medikation Dosage Dosierung" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
