       ] ;
       fhir:name [ fhir:v "ELGA e-Medikation Abgabe" ] ;
       fhir:description [ fhir:v "Abgabe" ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
