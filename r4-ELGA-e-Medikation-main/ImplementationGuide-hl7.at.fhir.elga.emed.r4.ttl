           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://fhir.hl7.at/elga/emed/r4/CodeSystem/ElgaListEntryFlagCS> ;
         fhir:reference [ fhir:v "CodeSystem/ElgaListEntryFlagCS" ]
       ] ;
       fhir:name [ fhir:v "ELGA List.entry.flag CodeSystem" ] ;
       fhir:description [ fhir:v "CodeSystem für zulässige Ausprägungen des Flags eines List.Entries in ELGA." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
