       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-medication-magistrale-zubereitung> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/at-elga-emed-medication-magistrale-zubereitung" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "AT ELGA e-Medikation Medication Magistrale Medikation" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Bildet eine Magistrale Zubereitung in der \"Medication\"-Ressource ab. Wird grundsätzlich verwendet in Planeintrag, Geplanter Abgabe und Durchgeführter Abgabe." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "Medikation" ]
     ], [
       fhir:index 7 ;
       fhir:Element.extension [
         fhir:index 0 ;
