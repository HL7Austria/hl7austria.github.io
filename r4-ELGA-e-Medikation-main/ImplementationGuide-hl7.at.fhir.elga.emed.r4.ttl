       ] ;
       fhir:name [ fhir:v "Beispiel: Geplante Abgabe" ] ;
       fhir:description [ fhir:v "Bildet eine geplante Abgabe des Medikaments EBETREXAT und zugehörigen Dosierungsanweisungen ab (MedicationRequest)." ] ;
       fhir:example [
         a fhir:Canonical ;
         fhir:v "https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-emed-mr-geplante-abgabe"^^xsd:anyURI ;
