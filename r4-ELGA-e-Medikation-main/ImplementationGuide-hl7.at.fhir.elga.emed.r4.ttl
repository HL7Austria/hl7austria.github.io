     fhir:grouping ( [
       fhir:id [ fhir:v "Medikationsplan" ] ;
       fhir:name [ fhir:v "Medikationsplan" ] ;
       fhir:description [ fhir:v "Medikationsplan" ]
     ] [
       fhir:id [ fhir:v "GeplanteAbgabe" ] ;
       fhir:name [ fhir:v "Geplante Abgabe" ] ;
       fhir:description [ fhir:v "Geplante Abgabe" ]
     ] [
       fhir:id [ fhir:v "DurchgefuehrteAbgabe" ] ;
       fhir:name [ fhir:v "Durchgeführte Abgabe" ] ;
       fhir:description [ fhir:v "Durchgeführte Abgabe" ]
     ] ) ;
     fhir:resource ( [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-bundle-medikationsplan> ;
         fhir:reference [ fhir:v "StructureDefinition/at-elga-emed-bundle-medikationsplan" ]
       ] ;
       fhir:name [ fhir:v "AT ELGA e-Medikation Collection Bundle Medikationsplan" ] ;
       fhir:description [ fhir:v "Das Bundle vom Typ Collection bestehend aus: \n- 1..1 Medikationsplan (List): Liste mit Referenzen auf Medikationsplaneinträge und zur Abbildung von Reihenfolge und Änderungsstatus \n- 0..* Medikationsplaneinträge (MedicationRequests): Medikation und Dosierung" ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ] ;
       fhir:groupingId [ fhir:v "Medikationsplan" ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:complex-type"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-dosage-dosierung> ;
         fhir:reference [ fhir:v "StructureDefinition/at-elga-emed-dosage-dosierung" ]
       ] ;
       fhir:name [ fhir:v "AT ELGA e-Medikation Dosage Dosierung" ] ;
       fhir:description [ fhir:v "AT ELGA e-Medikation Dosage Dosierung" ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-list-medikationsplan> ;
         fhir:reference [ fhir:v "StructureDefinition/at-elga-emed-list-medikationsplan" ]
       ] ;
       fhir:name [ fhir:v "AT ELGA e-Medikation List Medikationsplan" ] ;
       fhir:description [ fhir:v "Der Medikationsplan eines ELGA-Teilnehmers bzw. einer ELGA-Teilnehmerin wird durch eine List-Ressource abgebildet. \nDiese enthält 0..* Einträge (List.entry), wobei jedes Entry genau eine Referenz auf einen Medikationsplaneintrag (MedicationRequest) in List.entry.item beinhaltet.\nDie Reihenfolge der Einträge kann durch den GDA festgelegt werden. Jeder Listeneintrag enthält im Element List.entry.flag den Änderungsstatus des jeweiligen Medikationsplaneintrags." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ] ;
       fhir:groupingId [ fhir:v "Medikationsplan" ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-medication-medikation> ;
         fhir:reference [ fhir:v "StructureDefinition/at-elga-emed-medication-medikation" ]
       ] ;
       fhir:name [ fhir:v "AT ELGA e-Medikation Medication Medikation" ] ;
       fhir:description [ fhir:v "Bildet ein Arzneimittel in der \"Medication\"-Ressource ab. Wird grundsätzlich verwendet in Planeintrag, geplante Abgabe und durchgeführte Abgabe." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ] ;
       fhir:groupingId [ fhir:v "Medikationsplan" ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-medicationdispense-durchgefuehrteabgabe> ;
         fhir:reference [ fhir:v "StructureDefinition/at-elga-emed-medicationdispense-durchgefuehrteabgabe" ]
       ] ;
       fhir:name [ fhir:v "AT ELGA e-Medikation MedicationDispense Durchgeführte Abgabe" ] ;
       fhir:description [ fhir:v "Dokumentiert eine \"Durchgeführte Abgabe\" eines Arzneimittels (\"MedicationDispense\"-Ressource). \nDie \"Durchgeführte Abgabe\" enthält die abgegebene Medikation und deren Dosierung und dient somit der Nachvollziehbarkeit der abgegebenen Arzneimittel in der e-Medikation. \nEs können Abweichungen zur \"Geplanten Abgabe\" hinsichtlich des Medikaments und dessen Dosierung dokumentiert werden.\nSofern eine zugehörige \"Geplanten Abgabe\" vorliegt, muss diese mit dem zugehörigen Planeintrag referenziert werden. Eine mögliche Substitution des Medikaments ist implizit, durch die Referenz auf die zugehörige \"Geplante Abgabe\", ersichtlich.\nDer aktuelle Status einer \"Durchgeführten Abgabe\" wird mittels \"status\"- und \"type\"-Element dokumentiert. Es werden R5-Backport-Extensions verwendet." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ] ;
       fhir:groupingId [ fhir:v "DurchgefuehrteAbgabe" ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-medicationrequest-geplanteabgabe> ;
         fhir:reference [ fhir:v "StructureDefinition/at-elga-emed-medicationrequest-geplanteabgabe" ]
       ] ;
       fhir:name [ fhir:v "At ELGA e-Medikation MedicationRequest Geplante Abgabe" ] ;
       fhir:description [ fhir:v "Bildet eine \"Geplante Abgabe\" eines Arzneimittels aus dem zugrundeliegenden Medikationsplaneintrag des ELGA-Teilnehmers ab (\"MedicationRequest\"-Ressource mit Kategorie \"Geplante Abgabe\"):\nSie enthält die verordnete Medikation und deren Dosierung und spielgelt die Inhalte des e-Rezepts wider. Geplante Abgaben dienen somit der Nachvollziehbarkeit der rezeptierten Arzneimittel in der e-Medikation. \nWerden mehrere Medikamente gleichzeitig verordnet und sollen demselben e-Rezept zugeordnet sein, wird für jedes Medikament eine \"Geplante Abgabe\" mit demselben \"e-Med GroupIdentifier\" erstellt (bildet 'Rezept-Klammer'). \nEs werden R5-Backport-Extensions verwendet." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ] ;
       fhir:groupingId [ fhir:v "GeplanteAbgabe" ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-medicationrequest-planeintrag> ;
         fhir:reference [ fhir:v "StructureDefinition/at-elga-emed-medicationrequest-planeintrag" ]
       ] ;
       fhir:name [ fhir:v "At ELGA e-Medikation MedicationRequest Planeintrag" ] ;
       fhir:description [ fhir:v "Ein Medikationsplaneintrag im Medikationsplan eines ELGA-Teilnehmers bzw. einer ELGA-Teilnehmerin wird durch eine \"MedicationRequest\"-Ressource abgebildet.\nDie Ressource enthält genau ein Medikament mit der zugehörigen Dosierung, wobei das Medikament verpflichtend in einer contained Medication-Ressource (inline, d.h. innerhalb der Ressource), dokumentiert wird.\nDer Medikationsplaneintrag kann in weiterer Folge als Grundlage für die Erstellung einer \"Geplanten Abgabe\" dienen. Es werden R5-Backport-Extensions verwendet." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ] ;
       fhir:groupingId [ fhir:v "Medikationsplan" ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-substance-wirkstoff> ;
         fhir:reference [ fhir:v "StructureDefinition/at-elga-emed-substance-wirkstoff" ]
       ] ;
       fhir:name [ fhir:v "At ELGA e-Medikation Substance Wirkstoff" ] ;
       fhir:description [ fhir:v "Dokumentation des Wirkstoffs eines Arzneimittels in der ELGA e-Medikation, sofern es nicht kodiert vorliegt." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ] ;
       fhir:groupingId [ fhir:v "Medikationsplan" ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:complex-type"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-timing> ;
         fhir:reference [ fhir:v "StructureDefinition/at-elga-emed-timing" ]
       ] ;
       fhir:name [ fhir:v "AT ELGA e-Medikation Timing" ] ;
       fhir:description [ fhir:v "AT ELGA e-Medikation Timing" ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-bundle-medikationsplantx> ;
         fhir:reference [ fhir:v "StructureDefinition/at-elga-emed-bundle-medikationsplantx" ]
       ] ;
       fhir:name [ fhir:v "AT ELGA e-Medikation Transaction Bundle Medikationsplan" ] ;
       fhir:description [ fhir:v "Das Bundle vom Typ Transaction dient dem schreibenden Zugriff auf den ELGA Medikationsplan (Aktualisierung aller enthaltenen Ressourcen) und besteht aus: \n- 1..1 Medikationsplan (List): Liste mit Referenzen auf Medikationsplaneinträge und zur Abbildung von Reihenfolge und Änderungsstatus \n- 0..* Medikationsplaneinträge (MedicationRequests): Medikation und Dosierung\n\nAlle neuen bzw. geänderten und zu entfernenden Medikationsplaneinträge müssen inline im Bundle enthalten sein, alle unveränderten Ressourcen werden referenziert." ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ] ;
       fhir:groupingId [ fhir:v "Medikationsplan" ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "MedicationDispense"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/MedicationDispense/At-Emed-Example-Durchgefuehrte-Abgabe-01> ;
         fhir:reference [ fhir:v "MedicationDispense/At-Emed-Example-Durchgefuehrte-Abgabe-01" ]
       ] ;
       fhir:name [ fhir:v "Beispiel Durchgeführte Abgabe 1" ] ;
       fhir:description [ fhir:v "Beispiel Durchgeführte Abgabe 1" ] ;
       fhir:example [
         a fhir:canonical ;
         fhir:v "https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-medicationdispense-durchgefuehrteabgabe"^^xsd:anyURI ;
         fhir:link <https://fhir.hl7.at/elga/emed/r4/StructureDefinition/at-elga-emed-medicationdispense-durchgefuehrteabgabe>
       ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "MedicationRequest"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.hl7.at/elga/emed/r4/MedicationRequest/At-Emed-Example-Mr-Planeintrag> ;
         fhir:reference [ fhir:v "MedicationRequest/At-Emed-Example-Mr-Planeintrag" ]
       ] ;
       fhir:name [ fhir:v "Beispiel Example Medikationsplaneintrag" ] ;
       fhir:description [ fhir:v "Bildet einen Medikationsplaneintrag mit dem Medikament EBETREXAT und zugehörigen Dosierungsanweisungen ab (MedicationRequest)." ] ;
