           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://fhir.hl7.at/elga/emed/r4/ValueSet/ElgaListStatusVS> ;
         fhir:reference [ fhir:v "ValueSet/ElgaListStatusVS" ]
       ] ;
       fhir:name [ fhir:v "ELGA List Status ValueSet" ] ;
       fhir:description [ fhir:v "Zulässige Ausprägungen des Status einer List-Ressource in ELGA." ] ;
       fhir:example [
