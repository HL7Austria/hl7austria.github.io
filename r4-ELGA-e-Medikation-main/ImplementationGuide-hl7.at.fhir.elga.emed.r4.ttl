       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "OperationDefinition"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://fhir.hl7.at/elga/emed/r4/OperationDefinition/AtEmed.List.Readtowrite> ;
         fhir:reference [ fhir:v "OperationDefinition/AtEmed.List.Readtowrite" ]
       ] ;
       fhir:name [ fhir:v "e-Med Operation für Read-to-Write" ] ;
       fhir:description [ fhir:v "Die $readtowrite Operation wird aufgerufen, wenn ein Medikationsplan mit der Intention zu schreiben gelesen wird." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "OperationDefinition"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://fhir.hl7.at/elga/emed/r4/OperationDefinition/AtEmed.List.Write> ;
         fhir:reference [ fhir:v "OperationDefinition/AtEmed.List.Write" ]
       ] ;
       fhir:name [ fhir:v "e-Med Operation für Write des Medikationsplans" ] ;
       fhir:description [ fhir:v "Die $write Operation wird aufgerufen, wenn ein Medikationsplan geschrieben wird." ] ;
