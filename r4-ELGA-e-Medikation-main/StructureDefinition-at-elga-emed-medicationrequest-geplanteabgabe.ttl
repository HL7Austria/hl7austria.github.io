     fhir:StructureDefinition.mapping.uri [ fhir:value "http://ncpdp.org/SCRIPT10_6" ] ;
     fhir:StructureDefinition.mapping.name [ fhir:value "Mapping to NCPDP SCRIPT 10.6" ]
  ], [
     fhir:index 2 ;
