# - resource -------------------------------------------------------------------

<https://fhir.hl7.at/elga/aps/r4/Device/AtApsExampleDevice04> a fhir:Device ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "AtApsExampleDevice04"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "additional" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Dieses Gerät erzeugt ein APS FHIR-Dokument.</p></div>"
  ] ;
  fhir:Device.deviceName [
     fhir:index 0 ;
     fhir:Device.deviceName.name [ fhir:value "APS Generator" ] ;
     fhir:Device.deviceName.type [ fhir:value "user-friendly-name" ]
  ] ;
  fhir:Device.type [
     fhir:CodeableConcept.coding [
       fhir:index 0 ;
       a sct:49062001 ;
       fhir:Coding.system [ fhir:value "http://snomed.info/sct" ] ;
       fhir:Coding.code [ fhir:value "49062001" ] ;
       fhir:Coding.display [ fhir:value "Gerät" ]
     ]
  ] .

