  fhir:Questionnaire.description [ fhir:value "The WHOQOL-BREF is a 26-item instrument for assessing subjective quality of life in four domains: physical, psychological, social relationships, and environment. Developed by the WHO."] ;
  fhir:Questionnaire.purpose [ fhir:value "Assessment of subjective quality of life in the general population and in patients."] ;
