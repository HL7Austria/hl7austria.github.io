       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "AT PreNUDGE Observation Muscle Strengthening Sessions" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "This FHIR profile defines the Muscle Strengthening Sessions Observation recording the number of muscle-strengthening exercise sessions (e.g. weight training, resistance exercises with weights, resistance bands, or bodyweight) per week. Applicable for both automated wearable measurements (method = Automated) and self-reported values derived from MuscleStrengtheningQuantityQuestionnaire (method = Manual). The value must be 0 or greater." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
