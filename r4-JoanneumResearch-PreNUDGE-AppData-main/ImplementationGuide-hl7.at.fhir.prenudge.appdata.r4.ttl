       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Perceived Stress Scale (PSS-4)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "4-item short version of the Perceived Stress Scale (PSS-4) measuring subjective experience of stress over the past month. Scoring: items pss4-q2 and pss4-q3 are positive items reversed (4 – ordinal); items pss4-q1 and pss4-q4 are used as-is. Total score range 0–16; higher scores indicate greater perceived stress." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
