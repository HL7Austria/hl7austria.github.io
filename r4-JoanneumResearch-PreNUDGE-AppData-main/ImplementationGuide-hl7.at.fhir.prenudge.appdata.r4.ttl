       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Perceived Stress Scale (PSS-10)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "10-item Perceived Stress Scale (PSS-10; LOINC 106875-8) measuring subjective experience of stress over the past four weeks. Scoring: items q4, q5, q7, q8 are positive items reversed (4 – ordinal); items q1, q2, q3, q6, q9, q10 are used as-is. Total score range 0–40; higher scores indicate greater perceived stress." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
