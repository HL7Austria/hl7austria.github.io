       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.hl7.at/prenudge/appdata/r4/StructureDefinition/at-prenudge-work-soc-score-observation> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/at-prenudge-work-soc-score-observation" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "AT PreNUDGE Observation Work-SoC Category Score" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "This FHIR profile defines the calculated work-related sense of coherence (Work-SoC) category score observation. It contains the category scores for comprehensibility, manageability and meaningfulness as Observation components. The raw Work-SoC item answers are represented in the source QuestionnaireResponse." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
