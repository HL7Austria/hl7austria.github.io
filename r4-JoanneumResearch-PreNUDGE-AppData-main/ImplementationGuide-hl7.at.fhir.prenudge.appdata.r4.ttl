       fhir:ImplementationGuide.definition.resource.name [ fhir:value "AT PreNUDGE Observation Other not Quantities" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "This FHIR profile can be used for all the other Observations for PreNUDGE, not being an quantity and not fitting the existing narrow standardized observations." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
