       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "AT PreNUDGE Observation Nutrition Fruit Portions" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Records self-reported daily portions of fruit based on ATHIS 2025 question DH2. Applicable only for respondents who eat fruit daily (DH1 = 'Täglich oder mehrmals täglich'). Observation code: LOINC 80457-5 'Fruit servings 24 hour Estimated'." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
