       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.hl7.at/prenudge/appdata/r4/Observation/physical-activity-minutes-aggregate-only-example> ;
         fhir:Reference.reference [ fhir:value "Observation/physical-activity-minutes-aggregate-only-example" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Physical Activity Minutes O - (a) Aggregate Only (Manual)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Scenario (a): only component[aggregateActivity] is present.\nTypical for a questionnaire-derived observation that asks only for total activity\ntime without splitting moderate and vigorous.  pa-agg-01 passes silently because\nneither moderate nor vigorous is present." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://fhir.hl7.at/prenudge/appdata/r4/StructureDefinition/at-prenudge-physical-activity-minutes-observation" ;
         fhir:link <https://fhir.hl7.at/prenudge/appdata/r4/StructureDefinition/at-prenudge-physical-activity-minutes-observation>
       ]
     ], [
       fhir:index 101 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Observation" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.hl7.at/prenudge/appdata/r4/Observation/physical-activity-minutes-moderate-only-example> ;
         fhir:Reference.reference [ fhir:value "Observation/physical-activity-minutes-moderate-only-example" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Physical Activity Minutes O - (b) Moderate Only (Manual, pa-agg-01 warning)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Scenario (b): only component[moderateActivity] is present; aggregate absent.\npa-agg-01 fires a WARNING because moderateActivity is present but aggregateActivity\nis not.  The aggregate should equal moderateActivity + (0 × 2) = 150 min/wk;\na sender should add component[aggregateActivity] = 150 min/wk to suppress the warning.\nThis scenario may arise when a source captures moderate activity but omits the aggregate." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://fhir.hl7.at/prenudge/appdata/r4/StructureDefinition/at-prenudge-physical-activity-minutes-observation" ;
         fhir:link <https://fhir.hl7.at/prenudge/appdata/r4/StructureDefinition/at-prenudge-physical-activity-minutes-observation>
       ]
     ], [
