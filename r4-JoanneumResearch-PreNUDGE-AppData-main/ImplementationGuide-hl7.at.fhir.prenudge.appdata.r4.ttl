       ] ;
       fhir:name [ fhir:v "AT PreNUDGE Observation Sleep Duration" ] ;
       fhir:description [ fhir:v "This FHIR profile defines the Sleep Duration Observation recording average nightly sleep in hours. Applicable for both automated wearable measurements (method = automated) and self-reported values derived from a questionnaire (method = manual)." ] ;
