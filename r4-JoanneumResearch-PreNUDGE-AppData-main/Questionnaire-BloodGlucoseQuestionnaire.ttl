           a fhir:Expression ;
           fhir:language [ fhir:v "text/fhirpath" ] ;
           fhir:expression [ fhir:v "now().toString()" ]
         ]
       ] ) ;
       fhir:linkId [ fhir:v "datetime" ] ;
       fhir:text [ fhir:v "Wann haben sie diesen Wert gemessen?" ] ;
       fhir:type [ fhir:v "dateTime" ] ;
       fhir:required [ fhir:v true ]
     ] [
