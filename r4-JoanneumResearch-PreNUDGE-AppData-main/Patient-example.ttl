@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://fhir.hl7.at/prenudge/appdata/r4/Patient/example> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "example"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "https://fhir.hl7.at/elga/aps/r4/StructureDefinition/at-aps-patient" ;
       fhir:index 0 ;
       fhir:link <https://fhir.hl7.at/elga/aps/r4/StructureDefinition/at-aps-patient>
     ]
  ] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient example</b></p><a name=\"example\"> </a><a name=\"hcexample\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"https://fhir.hl7.at/elga/aps/r4/1.0.0/StructureDefinition-at-aps-patient.html\">AT APS Patient</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">James Pond  Male, DoB: 1990-01-01 ( urn:oid:1.2.40.0.10.1.4.3.1#1234567890)</p><hr/><table class=\"grid\"><tr><td style=\"background-color: #f3f5da\" title=\"Other Id (see the one above)\">Other Id:</td><td colspan=\"3\">Patient internal identifier/123123123</td></tr></table></div>"
  ] ;
  fhir:Patient.identifier [
     fhir:index 0 ;
     fhir:Identifier.system [ fhir:value "urn:oid:1.2.40.0.10.1.4.3.1" ] ;
     fhir:Identifier.value [ fhir:value "1234567890" ]
  ], [
     fhir:index 1 ;
     fhir:Identifier.type [
       fhir:CodeableConcept.coding [
         fhir:index 0 ;
         fhir:Coding.system [ fhir:value "http://terminology.hl7.org/CodeSystem/v2-0203" ] ;
         fhir:Coding.code [ fhir:value "PI" ]
       ]
     ] ;
     fhir:Identifier.system [ fhir:value "https://www.joanneum.at" ] ;
     fhir:Identifier.value [ fhir:value "123123123" ]
  ] ;
  fhir:Patient.name [
     fhir:index 0 ;
     fhir:HumanName.family [ fhir:value "Pond" ] ;
     fhir:HumanName.given [
       fhir:value "James" ;
       fhir:index 0
     ]
  ] ;
  fhir:Patient.gender [ fhir:value "male"] ;
  fhir:Patient.birthDate [ fhir:value "1990-01-01"^^xsd:date] .

# - ontology header ------------------------------------------------------------

<https://fhir.hl7.at/prenudge/appdata/r4/Patient/example.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

