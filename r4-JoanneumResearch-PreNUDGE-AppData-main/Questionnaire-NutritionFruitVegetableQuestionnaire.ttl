# - resource -------------------------------------------------------------------

<https://fhir.hl7.at/prenudge/appdata/r4/Questionnaire/NutritionFruitVegetableQuestionnaire> a fhir:Questionnaire ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "NutritionFruitVegetableQuestionnaire"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
