     fhir:Questionnaire.item.linkId [ fhir:value "DH2" ] ;
     fhir:Questionnaire.item.text [ fhir:value "DH2: Wie viele Portionen Obst essen Sie pro Tag? Eine Portion entspricht einer Handvoll Obst.\n\nEine Handvoll Obst kann sein:\n- 1 Apfel, 1 Banane, 1 Pfirsich, 2 Zwetschken, 2 Mandarinen, 2 Kiwis, 3 Marillen, 7 Erdbeeren, eine halbe Grapefruit\n- drei große Löffel ungezuckerter Obstsalat\n- bei halben Portionen aufrunden." ] ;
     fhir:Questionnaire.item.type [ fhir:value "integer" ] ;
