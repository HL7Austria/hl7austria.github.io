           fhir:transform [ fhir:v "copy" ] ;
           fhir:parameter ( [
             fhir:value [
               a fhir:string ;
               fhir:v "mg/dL"
             ]
           ] )
         ] )
       ] )
     ] )
  ] ) . # 

