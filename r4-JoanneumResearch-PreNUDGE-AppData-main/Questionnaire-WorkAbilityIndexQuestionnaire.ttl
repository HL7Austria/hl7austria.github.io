       fhir:display [ fhir:v "Work Ability Index short questionnaire" ]
     ] ) ;
     fhir:text [ fhir:v "Arbeitsfähigkeit" ] ;
     fhir:type [ fhir:v "group" ] ;
     fhir:item ( [
       fhir:extension ( [
