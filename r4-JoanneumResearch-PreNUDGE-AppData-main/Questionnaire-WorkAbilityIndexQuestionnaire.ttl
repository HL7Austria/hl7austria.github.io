         fhir:system [ fhir:v "https://fhir.hl7.at/prenudge/appdata/r4/CodeSystem/prenudge-workability"^^xsd:anyURI ] ;
         fhir:code [ fhir:v "wai-current-work-ability" ] ;
         fhir:display [ fhir:v "Current work ability compared with lifetime best" ]
       ] ) ;
       fhir:text [ fhir:v "Wenn Sie Ihre beste, je erreichte Arbeitsfähigkeit mit 10 Punkten bewerten: Wie viele Punkte würden Sie dann für Ihre derzeitige Arbeitsfähigkeit geben? 0 bedeutet, dass Sie derzeit völlig arbeitsunfähig sind; 10 bedeutet derzeit die beste Arbeitsfähigkeit." ] ;
       fhir:type [ fhir:v "integer" ] ;
       fhir:required [ fhir:v true ]
