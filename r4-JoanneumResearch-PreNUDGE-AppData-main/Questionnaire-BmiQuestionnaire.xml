      <use value="work"/>
    </telecom>
  </contact>
  <description value="Questionnaire for self-reporting body height and body weight. The Body Mass Index (BMI) is defined as an SDC calculated expression based on height in cm and weight in kg. The QuestionnaireResponse may be mapped to separate body height, body weight and BMI Observations."/>
  <item>
    <linkId value="bmi"/>
    <text value="Body Mass Index (BMI)"/>
    <type value="group"/>
    <item>
      <extension url="http://hl7.org/fhir/StructureDefinition/minValue">
        <valueDecimal value="50"/>
      </extension>
      <extension url="http://hl7.org/fhir/StructureDefinition/maxValue">
        <valueDecimal value="250"/>
      </extension>
      <linkId value="height-cm"/>
      <code>
        <system value="http://loinc.org"/>
        <code value="8302-2"/>
        <display value="Body height"/>
      </code>
      <text value="Körpergröße in Zentimetern (cm)"/>
      <type value="decimal"/>
      <required value="true"/>
    </item>
    <item>
      <extension url="http://hl7.org/fhir/StructureDefinition/minValue">
        <valueDecimal value="20"/>
      </extension>
      <extension url="http://hl7.org/fhir/StructureDefinition/maxValue">
        <valueDecimal value="300"/>
      </extension>
      <linkId value="weight-kg"/>
      <code>
        <system value="http://loinc.org"/>
        <code value="29463-7"/>
        <display value="Body weight"/>
      </code>
      <text value="Körpergewicht in Kilogramm (kg)"/>
      <type value="decimal"/>
      <required value="true"/>
    </item>
    <item>
      <extension url="http://hl7.org/fhir/StructureDefinition/minValue">
        <valueDecimal value="5"/>
      </extension>
      <extension url="http://hl7.org/fhir/StructureDefinition/maxValue">
        <valueDecimal value="100"/>
      </extension>
      <extension url="http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression">
        <valueExpression>
          <language value="text/fhirpath"/>
          <expression value="%resource.item.where(linkId = 'bmi').item.where(linkId = 'weight-kg').answer.valueDecimal.first() / ((%resource.item.where(linkId = 'bmi').item.where(linkId = 'height-cm').answer.valueDecimal.first() / 100) * (%resource.item.where(linkId = 'bmi').item.where(linkId = 'height-cm').answer.valueDecimal.first() / 100))"/>
        </valueExpression>
      </extension>
      <linkId value="bmi-kg-m2"/>
      <code>
        <system value="http://loinc.org"/>
        <code value="39156-5"/>
        <display value="Body mass index (BMI) [Ratio]"/>
      </code>
      <text value="Body Mass Index (BMI) in kg/m²"/>
      <type value="decimal"/>
      <required value="false"/>
      <readOnly value="true"/>
    </item>
    <item>
      <linkId value="comment"/>
      <text value="Haben Sie zu Ihren Angaben noch einen Kommentar oder etwas hinzuzufügen?"/>
      <type value="string"/>
    </item>
  </item>
