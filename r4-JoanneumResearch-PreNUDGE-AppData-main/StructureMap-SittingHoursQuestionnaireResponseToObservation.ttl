lor: navy\">)</span> <i>\"SetCode\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">effectiveDateTime from authored (Q9 has no embedded date sub-item)</span>#xD;\n  src.authored<b> as </b><span style=\"color: maroon\">authored</span><span style=\"color: navy\"><b> -&gt; </b></span>tgt.effectiveDateTime = <span style=\"color: maroon\">authored</span> <i>\"SetEffectiveDateTime\"</i><span style=\"color: navy\">;</span>#xD;\n  <span style=\"color: navy\">// </span><span style=\"color: green\">Map Q9 group to Observation.value</span>#xD;\n  src.item<b> as </b><span style=\"color: maroon\">item</span><b> where </b><span style=\"color: navy\">(</span>linkId = 'Q9'<span style=\"color: navy\">)</span><b> then </b>MapQ9ToSittingHours<span style=\"color: navy\">(</span><span style=\"color: maroon\">item</span><span style=\"color: navy\">, </span><span style=\"color: maroon\">tgt</span><span style=\"color: navy\">)</span> <i>\"ProcessQ9\"</i><span style=\"color: navy\">;</span>#xD;\n<span style=\"color: navy\">}#xD;\n#xD;\n</span><span style=\"color: navy\">// </span><span style=\"color: green\">---------------------------------------------------------------------------</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">Q9 → Observation.valueQuantity (h)</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">Q9-total-hours (decimal, SDC calculatedExpression) is read using the</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">MaLaC-HD 1.6.0 two-level .value unwrap pattern (valueDecimal → .value).</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">The arithmetic Q9-hours + (Q9-minutes / 60) is pre-computed by the</span>#xD;\n<span style=\"color: navy\">// </span><span style=\"color: green\">questionnaire; this map copies the result without evaluate().</span>#xD;\n<span style=\"color: navy\">// </span><span s