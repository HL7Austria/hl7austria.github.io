         fhir:reference [ fhir:v "ActorDefinition/at-scheduling-actor-scheduling-server" ]
       ] ;
       fhir:name [ fhir:v "HL7® AT Scheduling Server ActorDefinition" ] ;
       fhir:description [ fhir:v "A system providing the FHIR API for appointment booking and related data" ]
     ] ) ;
