         fhir:reference [ fhir:v "ActorDefinition/at-scheduling-actor-scheduling-client" ]
       ] ;
       fhir:name [ fhir:v "HL7® AT Scheduling Client ActorDefinition" ] ;
       fhir:description [ fhir:v "A system consuming the FHIR API provided by a Scheduling Server" ]
     ] [
       fhir:extension ( [
