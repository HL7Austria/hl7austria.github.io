  fhir:title [ fhir:v "MOPED VAERequest $beantworten (POC)"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:kind [ fhir:v "operation"] ; # 
  fhir:date [ fhir:v "2025-02-20T09:52:56+00:00"^^xsd:dateTime] ; # 
