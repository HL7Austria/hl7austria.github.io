  fhir:id [ fhir:v "MOPED.MopedVAEResponse.Beantworten"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: OperationDefinition MOPED.MopedVAEResponse.Beantworten</b></p><a name=\"MOPED.MopedVAEResponse.Beantworten\"> </a><a name=\"hcMOPED.MopedVAEResponse.Beantworten\"> </a><a name=\"MOPED.MopedVAEResponse.Beantworten-en-US\"> </a><p>URL: [base]/ClaimResponse/$beantworten</p><h3>Parameters</h3><table class=\"grid\"><tr><td><b>Use</b></td><td><b>Name</b></td><td><b>Scope</b></td><td><b>Cardinality</b></td><td><b>Type</b></td><td><b>Binding</b></td><td><b>Documentation</b></td></tr><tr><td>IN</td><td>MopedVAEResponse</td><td/><td>1..1</td><td><a href=\"http://hl7.org/fhir/R5/claimresponse.html\">ClaimResponse</a></td><td/><td><div><p>Der <em>MopedVAEResponse</em> Parameter beinhaltet sämtliche Details zur Antwort auf den VAERequest.</p>\n</div></td></tr><tr><td>OUT</td><td>return</td><td/><td>1..1</td><td><a href=\"http://hl7.org/fhir/R5/resource.html\">Resource</a> (<a href=\"http://hl7.org/fhir/R5/operationoutcome.html\" title=\"http://hl7.org/fhir/StructureDefinition/OperationOutcome\">OperationOutcome</a>)</td><td/><td><div><p>Der <em>return</em> Parameter gibt Auskunft über den Erfolg der Operation.</p>\n</div></td></tr></table></div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:url [ fhir:v "https://elga.moped.at/OperationDefinition/MOPED.MopedVAEResponse.Beantworten"^^xsd:anyURI] ; # 
