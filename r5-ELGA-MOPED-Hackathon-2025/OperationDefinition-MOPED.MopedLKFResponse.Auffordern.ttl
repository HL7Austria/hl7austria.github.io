  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: OperationDefinition MOPED.MopedLKFResponse.Auffordern</b></p><a name=\"MOPED.MopedLKFResponse.Auffordern\"> </a><a name=\"hcMOPED.MopedLKFResponse.Auffordern\"> </a><a name=\"MOPED.MopedLKFResponse.Auffordern-en-US\"> </a><p>URL: [base]/ClaimResponse/$auffordern</p><h3>Parameters</h3><table class=\"grid\"><tr><td><b>Use</b></td><td><b>Name</b></td><td><b>Scope</b></td><td><b>Cardinality</b></td><td><b>Type</b></td><td><b>Binding</b></td><td><b>Documentation</b></td></tr><tr><td>IN</td><td>MopedLKFResponse</td><td/><td>1..1</td><td><a href=\"http://hl7.org/fhir/R5/claimresponse.html\">ClaimResponse</a> (<a href=\"StructureDefinition-MopedLKFResponse.html\" title=\"https://elga.moped.at/StructureDefinition/MopedLKFResponse\">MopedLKFResponse</a>)</td><td/><td><div><p>Der <em>MopedLKFResponse</em> Parameter beinhält sämtliche Details zur Antwort auf den Claim.</p>\n</div></td></tr><tr><td>OUT</td><td>return</td><td/><td>1..1</td><td><a href=\"http://hl7.org/fhir/R5/resource.html\">Resource</a> (<a href=\"http://hl7.org/fhir/R5/operationoutcome.html\" title=\"http://hl7.org/fhir/StructureDefinition/OperationOutcome\">OperationOutcome</a>)</td><td/><td><div><p>Der <em>return</em> Parameter gibt Auskunft über den Erfolg der Operation.</p>\n</div></td></tr></table></div>"^^rdf:XMLLiteral
  ] ; # 
