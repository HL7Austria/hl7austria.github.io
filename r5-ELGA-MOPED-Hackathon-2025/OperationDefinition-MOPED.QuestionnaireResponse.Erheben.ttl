     fhir:max [ fhir:v "1" ] ;
     fhir:documentation [ fhir:v "Der *aufnahmezahl* Parameter beinhaltet den eindeutigen Identifizierer für den relevanten Fall." ] ;
     fhir:type [ fhir:v "Identifier" ]
  ] [
