     fhir:max [ fhir:v "1" ] ;
     fhir:documentation [ fhir:v "Der *return* Parameter gibt Auskunft über den Erfolg der Operation." ] ;
     fhir:type [ fhir:v "Resource" ] ;
     fhir:targetProfile ( [
       fhir:v "http://hl7.org/fhir/StructureDefinition/OperationOutcome"^^xsd:anyURI ;
