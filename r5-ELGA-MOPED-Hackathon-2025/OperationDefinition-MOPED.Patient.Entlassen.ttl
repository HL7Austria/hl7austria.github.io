  fhir:title [ fhir:v "MOPED Patient $entlassen (POC)"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:kind [ fhir:v "operation"] ; # 
  fhir:date [ fhir:v "2025-02-19T15:18:38+00:00"^^xsd:dateTime] ; # 
