                </td>
                <td>http://terminology.hl7.org/CodeSystem/v3-RoleClass</td>
                <td>guarantor</td>
                <td>
                  <div>
                    <p>A person or organization (player) that serves as a financial guarantor for another person or organization (scoper).</p>

                  </div>
                </td>
              </tr>
              <tr>
                <td style="white-space:nowrap">
                  <a name="x-http://terminology.hl7.org/CodeSystem/v3-RoleClass-CAREGIVER"> </a>  
                  <a href="http://terminology.hl7.org/6.2.0/CodeSystem-v3-RoleClass.html#v3-RoleClass-CAREGIVER">CAREGIVER</a>
                </td>
                <td>http://terminology.hl7.org/CodeSystem/v3-RoleClass</td>
                <td>caregiver</td>
                <td>
                  <div>
                    <p>A person responsible for the primary care of a patient at home.</p>

                  </div>
                </td>
              </tr>
              <tr>
                <td style="white-space:nowrap">
                  <a name="x-http://terminology.hl7.org/CodeSystem/v2-0131-E"> </a>  
                  <a href="http://terminology.hl7.org/6.2.0/CodeSystem-v2-0131.html#v2-0131-E">E</a>
                </td>
                <td>http://terminology.hl7.org/CodeSystem/v2-0131</td>
                <td>Employer</td>
