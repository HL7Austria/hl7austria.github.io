{
    "website": {
        "style": "fhir.layout",
        "url": "http://hl7.at/fhir/",
        "server": "apache",
        "org": "HL7 Austria",
        "clone-xml-json": false
    },
    "feeds": {
        "package": "package-feed.xml",
        "publication": "publication-feed.xml"
    },
    "layout-rules": [
        {
            "npm": "hl7.at.fhir.core.r5",
            "canonical": "http://hl7.at/fhir/HL7ATCoreProfiles/5.0.0",
            "destination": "/HL7-AT-FHIR-Core-R5"
        },
        {
            "npm": "hl7.at.fhir.core.r4",
            "canonical": "http://hl7.at/fhir/HL7ATCoreProfiles/4.0.1",
            "destination": "/HL7-AT-FHIR-Core-R4"
        },
        {
            "npm": "hl7.at.fhir.*.*.*.*",
            "canonical": "https://fhir.hl7.at/{4}/{5}/{6}/{7}",
            "destination": "/{4}/{5}/{6}/{7}"
        },
        {
            "npm": "hl7.at.fhir.*.*.*",
            "canonical": "https://fhir.hl7.at/{4}/{5}/{6}",
            "destination": "/{4}/{5}/{6}"
        }
    ]
}