     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Organization organization-examplehospital</b></p><a name=\"organization-examplehospital\"> </a><a name=\"hcorganization-examplehospital\"> </a><div style=\"display: inline-block; background-color: #fbffeb; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-trust-ai-organization.html\">Trust AI Responsible Organization</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Example Hospital (healthcare-provider)</p><hr/><table class=\"grid\"><tr><td style=\"background-color: #f3f5da\" title=\"Record is active\">Active:</td><td colspan=\"3\">true</td></tr><tr><td style=\"background-color: #f3f5da\" title=\"The kind(s) of organization that this is\">Type:</td><td colspan=\"3\"><span title=\"Codes:\">healthcare-provider</span></td></tr><tr><td style=\"background-color: #f3f5da\" title=\"Ways to contact the organization\">Administrative:</td><td colspan=\"3\"><ul><li><a href=\"mailto:contact@examplehospital.example\">contact@examplehospital.example</a></li></ul></td></tr><tr><td style=\"background-color: #f3f5da\" title=\"Ways to contact the organization\">Data Protection Officer:</td><td colspan=\"3\"><ul><li>Data Protection Officer</li><li><a href=\"mailto:dpo@examplehospital.example\">dpo@examplehospital.example</a></li></ul></td></tr><tr><td style=\"background-color: #f3f5da\" title=\"Ways to contact the organization\">AI Incident Reporting Contact:</td><td colspan=\"3\"><ul><li>AI Incident Reporting Contact</li><li><a href=\"mailto:incidents@examplehospital.example\">incidents@examplehospital.example</a></li></ul></td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:active [ fhir:v true] ; # 
